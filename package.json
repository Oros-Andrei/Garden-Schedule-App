{
  "name": "garden-app",
  "productName": "Garden Schedule",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "webpack serve --port 8080 --open",
    "build": "webpack --mode production",
    "dev": "webpack serve --port 8080 --hot",
    "desktop:dev": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win dir",
    "package:win:zip": "npm run build && electron-builder --win zip",
    "package:win:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.5.3",
    "ts-loader": "^9.4.4",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.andrei.gardenschedule",
    "productName": "Garden Schedule",
    "directories": {
      "output": "Garden Storage"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "disableAsarIntegrity": true,
    "artifactName": "Garden-Schedule-Portable-${arch}.${ext}",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
